---
interface Story {
  headline: string;
  byline: string;
  date: string;
  url: string;
  image: string;
  alt: string;
  tags: string[];
  featured?: boolean;
}

interface Props { story: Story; initiallyVisible?: boolean; }
const { story, initiallyVisible = true } = Astro.props;
---

<article
  class:list={['story-card', { 'story-card--featured': story.featured }]}
  data-story
  data-tags={story.tags.join('|')}
  data-featured={story.featured ? 'true' : undefined}
  hidden={!initiallyVisible}
>
  <a
    class:list={['story-image', story.featured ? 'story-image--featured' : 'story-image--compact']}
    href={story.url}
    aria-hidden="true"
    tabindex="-1"
  >
    <img src={story.image} alt={story.alt} loading="lazy" />
  </a>
  <div class="story-body">
    <ul class="story-tags" aria-label="Story tags">
      {story.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <h3><a href={story.url}>{story.headline}</a></h3>
    <p class="story-meta"><span>{story.byline}</span><time>{story.date}</time></p>
  </div>
</article>
