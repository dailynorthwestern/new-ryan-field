---
import { Image } from 'astro:assets';
import atmosphere from '../assets/atmosphere.JPG';
import retrogfx1 from '../assets/retrogfx1.png';
import retrogfx2 from '../assets/retrogfx2.png';

const {
  title = 'Gameday',
  dek = `From the opening of the Wildcats’ $875 million stadium to a complex offense under offensive coordinator Chip Kelly, Northwestern football has entered a "new era" in the 2026 season.`,
  byline = 'By The Daily Northwestern staff',
} = Astro.props;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <Image class="hero-media" src={atmosphere} alt="" loading="eager" fetchpriority="high" />
  <div class="hero-scrim" aria-hidden="true"></div>
  <Image class="hero-overlay" src={retrogfx1} alt="" aria-hidden="true" />
  <Image class="hero-overlay2" src={retrogfx2} alt="" aria-hidden="true" />
  <div class="hero-rules" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="hero-content shell">
    <h1 id="hero-title" set:html={title}></h1>
    <p class="hero-dek">{dek}</p>
    <p class="hero-byline">{byline}</p>
  </div>
  <a class="scroll-cue" href="#photos"><span>↓</span></a>
</section>


