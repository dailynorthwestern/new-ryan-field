---
import '../styles/global.css';

const {
  title = 'Gameday | The Daily Northwestern',
  description = 'The Daily Northwestern’s landing page for Gameday coverage',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d0235" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/favicon.png`} />
    <link rel="stylesheet" href="https://use.typekit.net/ryk0qlm.css">
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
