---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import StoriesSection from '../components/StoriesSection.astro';
import Timeline from '../components/Timeline.astro';
import { photos } from '../data/photos.js';
import { timeline } from '../data/timeline.js';
import { stories } from '../data/stories.js';
---

<Layout>
  <Header wordmarkSrc="/images/dailynu-wordmark.svg" />
  <main id="main-content">
    <Hero />
    <PhotoCarousel photos={photos} />
    <Timeline entries={timeline} />
    <StoriesSection stories={stories} />
  </main>
  <footer class="site-footer">
    <div class="shell footer-inner">
      <p class="footer-mark">The Daily Northwestern</p>
      <p>Independent student journalism since 1881.</p>
      <p>© 2026 The Daily Northwestern</p>
    </div>
  </footer>
</Layout>
